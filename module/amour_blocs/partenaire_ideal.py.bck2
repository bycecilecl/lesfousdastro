# module/amour_blocs/partenaire_ideal.py
# VERSION ENRICHIE AVEC LOGGING - Portrait intense du partenaire idéal

import logging
from module.amour_bdd import (
    get_from_placements,
    get_from_aspects,
    df_to_snippets,
)
from module.amour_blocs.utils_theme import exporter_theme_complet
from module.amour_blocs.context_amour import generer_contexte_amour
# Configuration du logger pour ce fichier
logger = logging.getLogger(__name__)
# Si tu n'as pas de config de log globale, ceci permet d'afficher les logs dans la console :
logging.basicConfig(level=logging.INFO, format='%(levelname)s: %(message)s')

def _df_to_interpretations_only(df) -> str:
    """
    Pour ce module Partenaire idéal, on ne prend QUE la colonne INTERPRÉTATION.
    """
    if df is None or df.empty:
        return ""

    df = df.rename(columns={c: c.strip().lower() for c in df.columns})

    if "interpretation" not in df.columns:
        logger.warning(f"[PARTENAIRE] Colonne 'interpretation' absente. Colonnes dispo: {list(df.columns)}")
        return ""

    lignes = []
    for _, row in df.iterrows():
        val = str(row["interpretation"]).strip()
        if val and val.lower() != "nan":
            lignes.append(f"- {val}")
    return "\n".join(lignes)


def _get_aspects_reels_du_theme(theme: dict) -> list:
    """
    Extrait les aspects réels présents dans le thème.
    Retourne une liste de tuples (planete_1, planete_2, type_aspect, orbe)
    """
    aspects_list = theme.get("aspects", [])
    
    aspects_reels = []
    for asp in aspects_list:
        p1 = asp.get("planete1")
        p2 = asp.get("planete2")
        type_asp = asp.get("aspect")
        orbe = asp.get("orbe", 0)
        
        if p1 and p2 and type_asp:
            aspects_reels.append((p1, p2, type_asp, orbe))
    
    logger.debug(f"[PARTENAIRE] {len(aspects_reels)} aspects bruts extraits du thème.")
    return aspects_reels


def _snippets_planetes_partenaires(theme: dict, polarite: str) -> str:
    """
    Bloc 1 : Planètes "partenaire" en SIGNE
    Femme  : Mars + Soleil
    Homme  : Vénus + Lune
    """
    planetes_theme = theme.get("planetes", {}) or theme.get("planètes", {}) or {}

    if polarite == "Femme":
        combos = [("Mars", "Partenaire"), ("Soleil", "Partenaire")]
    else:
        combos = [("Vénus", "Partenaire"), ("Lune", "Partenaire")]

    lignes = []
    logger.info(f"[PARTENAIRE] Recherche des positions en SIGNE pour : {[c[0] for c in combos]}")

    for nom_planete, bloc in combos:
        donnees = planetes_theme.get(nom_planete, {}) or {}
        signe = donnees.get("signe")
        
        if not signe:
            logger.warning(f"[PARTENAIRE] ⚠️ Pas de signe trouvé dans le JSON pour {nom_planete}")
            continue

        df = get_from_placements(
            planete=nom_planete,
            type_donnee="Signe",
            valeur=signe,
            bloc=bloc,
            polarite=polarite,
        )

        if not df.empty:
            logger.info(f"[PARTENAIRE] ✅ Trouvé : {nom_planete} en {signe} ({len(df)} interprétations)")
            txt = _df_to_interpretations_only(df)
            if txt:
                lignes.append(f"=== {nom_planete.upper()} EN {signe.upper()} ===")
                lignes.append(txt)
        else:
            logger.warning(f"[PARTENAIRE] ❌ Rien trouvé en BDD pour {nom_planete} en {signe} (Bloc: {bloc})")

    return "\n".join(lignes).strip()

def _filtrer_aspects_partenaires(
    theme: dict,
    planetes_ref: list[str],
    orbe_max: float = 6.0,
    max_par_planete: int = 2,
) -> dict[str, list[tuple[str, str, str, float]]]:
    """
    Sélectionne les aspects les plus pertinents vers les planètes 'partenaire'
    (Mars/Soleil ou Vénus/Lune selon la polarité).

    - On garde uniquement :
      • aspects majeurs (Conjonction, Carré, Opposition, Trigone, Sextile)
      • orbe <= orbe_max
      • aspects impliquant des planètes 'relationnelles' quand elles sont là
        (Pluton, Neptune, Chiron, Saturne, Jupiter, Vénus, Mars, Lune, Soleil)

    - On renvoie au max `max_par_planete` aspects par planète partenaire,
      pour éviter de noyer le LLM.
    """
    aspects_reels = _get_aspects_reels_du_theme(theme)
    aspects_majeurs = {"Conjonction", "Carre", "Carré", "Opposition", "Trigone", "Sextile"}

    # Planètes dont on "booste" l’importance dans la sélection
    planetes_relationnelles = {"Pluton", "Neptune", "Chiron", "Saturne", "Jupiter",
                               "Vénus", "Venus", "Mars", "Lune", "Soleil", "Uranus",}

    # Collecte brute
    par_planete_ref: dict[str, list[tuple[str, str, str, float]]] = {ref: [] for ref in planetes_ref}

    for (p1, p2, type_asp, orbe) in aspects_reels:
        if type_asp not in aspects_majeurs:
            continue
        if orbe is None or orbe > orbe_max:
            continue

        for ref in planetes_ref:
            if ref not in (p1, p2):
                continue

            autre = p2 if p1 == ref else p1

            # On ne retient que si l'autre planète est relationnelle
            if autre not in planetes_relationnelles:
                continue

            par_planete_ref.setdefault(ref, []).append((ref, autre, type_asp, orbe))

    # Tri + sélection limitée
    resultat: dict[str, list[tuple[str, str, str, float]]] = {}

    for ref, lst in par_planete_ref.items():
        if not lst:
            continue

        def score(item):
            _ref, autre, _, orbe = item

            # Bonus pour certaines planètes (Pluton, Neptune, Chiron surtout)
            if autre in {"Pluton", "Neptune", "Chiron"}:
                bonus = -1.0  # plus petit = plus prioritaire
            elif autre in {"Saturne", "Jupiter"}:
                bonus = -0.5
            else:
                bonus = 0.0

            # On veut d'abord l’orbe serrée, puis la planète "lourde"
            return (orbe + bonus)

        lst_tries = sorted(lst, key=score)

        # ⚠️ spécial : si deux aspects de "familles" différentes sont serrés,
        # on en garde deux (ex : Lune–Saturne + Lune–Uranus)
        selection: list[tuple[str, str, str, float]] = []
        familles_vues: set[str] = set()

        def famille(autre: str) -> str:
            if autre == "Saturne":
                return "saturne"
            if autre == "Uranus":
                return "uranus"
            if autre == "Neptune":
                return "neptune"
            if autre == "Pluton":
                return "pluton"
            if autre == "Chiron":
                return "chiron"
            if autre == "Jupiter":
                return "jupiter"
            return "autre"

        for (r, autre, tasp, orb) in lst_tries:
            fam = famille(autre)

            if not selection:
                # On prend toujours le plus serré
                selection.append((r, autre, tasp, orb))
                familles_vues.add(fam)
                continue

            if len(selection) >= max_par_planete:
                break

            # Si c'est une autre "famille" (ex : Saturne + Uranus), on garde aussi
            if fam not in familles_vues:
                selection.append((r, autre, tasp, orb))
                familles_vues.add(fam)

        resultat[ref] = selection

    return resultat

