# utils/analyse_karmique_renderer.py

from __future__ import annotations
from typing import Any, Dict, List, Optional, Callable
from utils.karmique.karmique_bdd import get_karmique_interp
from utils.karmique.chapitres.luminaires_karmiques import interpret_block_luminaires_karmiques_llm

def _bdd(astre: str, donnee: str, valeur) -> str:
    """
    Helper: renvoie le texte BDD si trouvé, sinon "".
    valeur peut être int/str.
    """
    if valeur is None:
        return ""
    txt = get_karmique_interp(astre, donnee, str(valeur))
    return txt.strip() if isinstance(txt, str) and txt.strip() else ""



def render_all(
    blocks: List[Dict[str, Any]],
    theme: Dict[str, Any],
    score: Dict[str, Any],
    call_llm: Optional[Callable[[str], str]] = None,
    global_ctx: Optional[Dict[str, Any]] = None,
) -> List[Dict[str, Any]]:
    """
    Remplit block["content"] pour chaque bloc.
    Pour l'instant: texte brut.
    Plus tard: tu remplaceras le texte par du HTML (mêmes fonctions, même pipeline).
    """
    out = []
    for b in blocks:
        bb = dict(b)

        # ✅ si le bloc a déjà du contenu, on le garde
        if isinstance(bb.get("content"), str) and bb["content"].strip():
            out.append(bb)
            continue

        bb["content"] = render_block(bb, theme, score, call_llm=call_llm, global_ctx=global_ctx)
        out.append(bb)

    return out


def render_block(
    block: Dict[str, Any],
    theme: Dict[str, Any],
    score: Dict[str, Any],
    call_llm: Optional[Callable[[str], str]] = None,
    global_ctx: Optional[Dict[str, Any]] = None,
) -> str:
    bid = block.get("id")

    if bid == "header":
        return _render_header(block, theme, score)
    
    if bid == "intro_karmique":
        return _render_intro_karmique(block, theme, score)
    
    if bid == "moon_karmique":
        return _render_moon_karmique(block, theme, score)
        
    if bid == "elements":
        return _render_elements(block, theme, score)
    
    if bid == "sensitive_points":
        return _render_sensitive_points(block, theme, score)
    
    if bid == "luminaires_karmiques":
        # si le builder a déjà mis du contenu, on le laisse
        if isinstance(block.get("content"), str) and block["content"].strip():
            return block["content"]
        if isinstance(block.get("text"), str) and block["text"].strip():
            return block["text"]

        # sinon, si LLM dispo, on transforme le brut en chapitre client-friendly
        if call_llm:
            return interpret_block_luminaires_karmiques_llm(
                block, theme, score, call_llm=call_llm, global_ctx=global_ctx
            )

        # fallback : renvoyer le brut (content/text) sinon rien
        return block.get("content") or block.get("text") or ""

    if bid == "lunar_nodes":
        return _render_lunar_nodes(block, theme, score)

    if bid == "karmic_houses":
        return _render_karmic_houses(block, theme, score)
    
    if bid == "maison_12":
        return _render_maison_12(block, theme, score)
    
    if bid == "retrogrades":
        return _render_retrogrades(block, theme, score)

    if bid == "interceptions":
        return _render_interceptions(block, theme, score)
    
    if bid == "amas_signes":
        return _render_amas_signes(block, theme, score)
    
    if bid == "saturn_pluto":
        return _render_saturn_pluto(block, theme, score)
    
    if bid == "synthese_karmique":
        return _render_synthese_karmique(block, theme, score)
    
    # bloc inconnu => pas d'erreur, juste vide
    return ""


# -----------------------
# Renderers (texte brut)
# -----------------------

def _render_header(block: Dict[str, Any],
                   theme: Dict[str, Any],
                   score: Dict[str, Any]) -> str:
    total = score.get("total", "—")
    label = score.get("label", "—")
    breakdown = score.get("breakdown", {}) or {}

    lines = [
        f"Poids karmique : {total} — {label}",
        "",
        "Répartition :",
    ]

    elements = score.get("meta", {}).get("dominant_elements")

    if elements:
        lines.insert(2, f"Dominante(s) élémentaire(s) : {' / '.join(elements)}")
        lines.insert(3, "")

    for k, v in breakdown.items():
        if v:
            lines.append(f"- {k} : {v}")
    return "\n".join(lines)


def _render_lunar_nodes(block: Dict[str, Any],
                        theme: Dict[str, Any],
                        score: Dict[str, Any]) -> str:
    
     # ✅ Priorité 1 : content
    if isinstance(block.get("content"), str) and block["content"].strip():
        return block["content"]
    
    # ✅ Priorité 2 : text
    if isinstance(block.get("text"), str) and block["text"].strip():
        return block["text"]
    

    data = (block.get("data") or {})

    nn_sign = data.get("nn_sign")
    nn_house = data.get("nn_house")
    ns_sign = data.get("ns_sign")
    ns_house = data.get("ns_house")

    # anciens champs (fallback)
    nn_ruler = data.get("nn_ruler")
    nn_ruler_house = data.get("nn_ruler_house")
    ns_ruler = data.get("ns_ruler")
    ns_ruler_house = data.get("ns_ruler_house")
    nn_ruler_aspects = data.get("nn_ruler_aspects", []) or []
    ns_ruler_aspects = data.get("ns_ruler_aspects", []) or []

    # nouveaux champs (source principale)
    nn_rulers_details = data.get("nn_rulers_details", []) or []
    ns_rulers_details = data.get("ns_rulers_details", []) or []

    lines = [
        f"Nœud Nord : {nn_sign} (Maison {nn_house})",
        f"Nœud Sud  : {ns_sign} (Maison {ns_house})",
        "",
    ]

    # ---------
    # NŒUD NORD
    # ---------
    if nn_rulers_details:
        names = [d.get("name") for d in nn_rulers_details if d.get("name")]
        lines.append(f"Maître(s) du Nœud Nord : {' / '.join(names) if names else '—'}")

        for d in nn_rulers_details:
            nm = d.get("name")
            if not nm:
                continue
            
            # ✅ Va chercher le signe dans le thème
            planets = theme.get("planetes", {})
            info = planets.get(nm, {})
            sig = info.get("signe")
            hs_from_theme = info.get("maison")  # Plus fiable que d.get("house")
            
            # Construit l'affichage
            parts = []
            if sig:
                parts.append(str(sig))
            if hs_from_theme is not None:
                parts.append(f"Maison {hs_from_theme}")
            extra = " — ".join(parts) if parts else "—"
            
            lines.append(f"- {nm} ({extra})")
            
            for a in (d.get("aspects") or [])[:5]:
                orb = a.get("orb")
                orb_txt = f"{orb:.2f}" if isinstance(orb, (int, float)) else (orb if orb is not None else "—")
                lines.append(f"  • {a.get('type')} avec {a.get('with')} (orbe {orb_txt})")
    else:
        # fallback ancien format (un seul maître)
        lines.append(f"Maître du Nœud Nord : {nn_ruler or '—'} (Maison {nn_ruler_house if nn_ruler_house is not None else '—'})")
        if nn_ruler_aspects:
            lines.append("Aspects du maître du Nœud Nord :")
            for a in nn_ruler_aspects[:5]:
                orb = a.get("orb")
                orb_txt = f"{orb:.2f}" if isinstance(orb, (int, float)) else (orb if orb is not None else "—")
                lines.append(f"- {a.get('type')} avec {a.get('with')} (orbe {orb_txt})")

    lines.append("")
    
    # ---------
    # NŒUD SUD
    # ---------
    if ns_rulers_details:
        names = [d.get("name") for d in ns_rulers_details if d.get("name")]
        lines.append(f"Maître(s) du Nœud Sud : {' / '.join(names) if names else '—'}")

        for d in ns_rulers_details:
            nm = d.get("name")
            if not nm:
                continue
            
            # ✅ Va chercher le signe dans le thème
            planets = theme.get("planetes", {})
            info = planets.get(nm, {})
            sig = info.get("signe")
            hs_from_theme = info.get("maison")  # Plus fiable que d.get("house")
            
            # Construit l'affichage
            parts = []
            if sig:
                parts.append(str(sig))
            if hs_from_theme is not None:
                parts.append(f"Maison {hs_from_theme}")
            extra = " — ".join(parts) if parts else "—"
            
            lines.append(f"- {nm} ({extra})")
            
            for a in (d.get("aspects") or [])[:5]:
                orb = a.get("orb")
                orb_txt = f"{orb:.2f}" if isinstance(orb, (int, float)) else (orb if orb is not None else "—")
                lines.append(f"  • {a.get('type')} avec {a.get('with')} (orbe {orb_txt})")
    else:
        # fallback ancien format
        lines.append(f"Maître du Nœud Sud : {ns_ruler or '—'} (Maison {ns_ruler_house if ns_ruler_house is not None else '—'})")
        if ns_ruler_aspects:
            lines.append("Aspects du maître du Nœud Sud :")
            for a in ns_ruler_aspects[:5]:
                orb = a.get("orb")
                orb_txt = f"{orb:.2f}" if isinstance(orb, (int, float)) else (orb if orb is not None else "—")
                lines.append(f"- {a.get('type')} avec {a.get('with')} (orbe {orb_txt})")

    return "\n".join(lines)


def _render_karmic_houses(block: Dict[str, Any],
                          theme: Dict[str, Any],
                          score: Dict[str, Any]) -> str:
    active = block.get("active_houses", {}) or {}
    lines = ["Maisons karmiques activées :"]
    for h in sorted(active.keys()):
        lines.append(f"- Maison {h} : " + ", ".join(active[h]))
    return "\n".join(lines)


def _render_interceptions(block: Dict[str, Any],
                          theme: Dict[str, Any],
                          score: Dict[str, Any]) -> str:
    # ✅ Priorité 1 : content (si encore présent)
    if isinstance(block.get("content"), str) and block["content"].strip():
        return block["content"]
    
    # ✅ Priorité 2 : text (sauvegarde du builder)
    if isinstance(block.get("text"), str) and block["text"].strip():
        return block["text"]
    
    # ✅ Priorité 3 : fallback minimal
    data = block.get("data", {}) or {}
    signes = data.get("signes_interceptes", []) or []
    axes = data.get("axes_interceptes", []) or []
    rulers = data.get("intercepted_rulers", []) or []

    lines = []
    if signes:
        lines.append("Signes interceptés : " + ", ".join(signes))
    if axes:
        lines.append("Axes interceptés : " + ", ".join([f"{a[0]}–{a[1]}" for a in axes if isinstance(a, (list, tuple)) and len(a) == 2]))
    if rulers:
        lines.append("Maîtres concernés : " + ", ".join(rulers))
    
    return "\n".join(lines) if lines else ""

def _render_amas_signes(block: Dict[str, Any],
                        theme: Dict[str, Any],
                        score: Dict[str, Any]) -> str:
    data = (block.get("data") or {})
    amas_list = data.get("amas_signes", []) or []

    if not amas_list:
        return ""

    lines = ["Amas par signe :"]
    for a in amas_list:
        signe = a.get("signe", "—")
        planetes = a.get("planetes", []) or []
        score_impact = a.get("score_impact", 0)

        flags = []
        if a.get("is_water"):
            flags.append("Eau")
        if a.get("is_south_node_sign"):
            flags.append("Signe du Nœud Sud")

        ftxt = f" ({', '.join(flags)})" if flags else ""
        lines.append(f"- {signe} : {', '.join(planetes)}{ftxt} → +{score_impact}")

    return "\n".join(lines)


def _render_retrogrades(block, theme, score) -> str:
    # ✅ Priorité 1 : content (si encore présent)
    if isinstance(block.get("content"), str) and block["content"].strip():
        return block["content"]
    
    # ✅ Priorité 2 : text (sauvegarde du builder)
    if isinstance(block.get("text"), str) and block["text"].strip():
        return block["text"]

    # ✅ Priorité 3 : fallback minimal
    data = block.get("data") or {}
    retro = data.get("retrogrades") or []
    if not retro:
        return ""

    lines = ["Planètes rétrogrades :"]
    for r in retro:
        name = r.get("name", "—")
        signe = r.get("signe", "—")
        maison = r.get("maison", "—")
        lines.append(f"- {name} ({signe} — Maison {maison})")
    return "\n".join(lines)

