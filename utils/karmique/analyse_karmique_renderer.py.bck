def _render_sensitive_points(block: Dict[str, Any],
                             theme: Dict[str, Any],
                             score: Dict[str, Any]) -> str:
    data = (block.get("data") or {})
    points = data.get("points", []) or []
    cuspides = data.get("cuspides", []) or []

    # s'il n'y a NI points à 29° NI cuspides → on ne rend rien
    if not points and not cuspides:
        return ""

    lines = ["Degrés à 29° (fin de cycle / pression d’aboutir) :"]
    for p in points:
        name = p.get("name", "—")
        deg = p.get("deg", "—")
        signe = p.get("signe")
        maison = p.get("maison")

        extra = []
        if signe:
            extra.append(str(signe))
        if maison:
            extra.append(f"Maison {maison}")

        tag = " ✅ VIP" if p.get("is_vip") else ""

        if extra:
            lines.append(f"- {name} : {deg}° ({' — '.join(extra)}){tag}")
        else:
            lines.append(f"- {name} : {deg}°{tag}")

    # --- AJOUT : cuspides (27°–3°) ---
    cuspides = data.get("cuspides", []) or []

    if cuspides:
        lines.append("")
        lines.append("Entre-deux signes (27°–3°) :")
        for c in cuspides:
            name = c.get("name")
            deg = c.get("deg")
            current = c.get("current_sign")
            other = c.get("other_sign")
            position = c.get("position")

            if position == "fin":
                txt = f"va vers {other}"
            else:
                txt = f"vient de {other}"

            lines.append(
                f"- {name} : {deg}° {current} ({position}) — {txt}"
            )

    return "\n".join(lines)

def _render_saturn_pluto(block: Dict[str, Any],
                         theme: Dict[str, Any],
                         score: Dict[str, Any]) -> str:
    data = block.get("data") or {}
    on_angles = data.get("on_angles") or []
    hard = data.get("hard_aspect")

    lines = ["Saturne / Pluton :"]

    if on_angles:
        lines.append("Conjonction à un angle (orbe ≤ 5°) :")
        for x in on_angles:
            planet = x.get("planet")
            ang = x.get("angle")
            orb = x.get("orb")
            ps = x.get("planet_sign")
            ph = x.get("planet_house")

            extra = []
            if ps:
                extra.append(ps)
            if ph is not None:
                extra.append(f"Maison {ph}")

            extra_txt = f" ({' — '.join(extra)})" if extra else ""
            lines.append(f"- {planet} conjoint {ang} (orbe {orb}°){extra_txt}")

        lines.append("")
        lines.append("👉 Lecture rapide : ça rend Saturne/Pluton très ‘audibles’ dans la vie :")
        lines.append("   - Saturne = cadre, exigence, réalité")
        lines.append("   - Pluton  = transformation, intensité, mue")
        lines.append("   Quand c’est collé à un angle : ça se voit, ça se vit, ça marque.")

    if hard:
        typ = hard.get("type")
        orb = hard.get("orb")
        sat = hard.get("saturne", {}) or {}
        plu = hard.get("pluton", {}) or {}

        sat_txt = []
        if sat.get("sign"):
            sat_txt.append(sat["sign"])
        if sat.get("house") is not None:
            sat_txt.append(f"Maison {sat['house']}")

        plu_txt = []
        if plu.get("sign"):
            plu_txt.append(plu["sign"])
        if plu.get("house") is not None:
            plu_txt.append(f"Maison {plu['house']}")

        lines.append(f"Aspect dur Saturne–Pluton : {typ} (orbe {orb}°)")
        if sat_txt or plu_txt:
            lines.append(f"- Saturne : {' — '.join(sat_txt) if sat_txt else '—'}")
            lines.append(f"- Pluton  : {' — '.join(plu_txt) if plu_txt else '—'}")

        lines.append("")
        lines.append("👉 Lecture rapide : tension ‘construction vs destruction’.")
        lines.append("   Ça pousse à faire du solide… mais en acceptant de perdre l’ancien au passage.")

        lines.append("")
        lines.append(f"DEBUG on_angles={on_angles}")
        lines.append(f"DEBUG hard={hard}")

    return "\n".join(lines)

def _render_elements(block: Dict[str, Any],
                     theme: Dict[str, Any],
                     score: Dict[str, Any]) -> str:
    data = block.get("data") or {}
    counts = data.get("elements_count") or {}
    lum = data.get("elements_luminaries") or {}
    pers = data.get("elements_personal_extended") or {}
    dom = data.get("dominant_elements") or []

    if not counts or not dom:
        return ""

    lines = []
    lines.append("Dominante(s) élémentaire(s) : " + " / ".join(dom))
    lines.append("")

    # Interprétation BDD par dominante
    # Clés CSV conseillées :
    # ASTRE=KARMIQUE, DONNEE=element, VALEUR=Air (ou Terre/Feu/Eau)
    for e in dom:
        txt = _bdd("Karmique", "element", e)
        if txt:
            lines.append(f"• {e} : {txt}")

    if dom:
        lines.append("")

    lines.append("Comptage (planètes + angles) :")
    for e in ("Feu", "Terre", "Air", "Eau"):
        lines.append(f"- {e} : {counts.get(e, 0)}")

    if len(dom) > 1:
        lines.append("")
        lines.append("Départage : luminaires → planètes personnelles étendues.")
        lines.append("Luminaires : " + ", ".join([f"{e}={lum.get(e,0)}" for e in ("Feu","Terre","Air","Eau")]))
        lines.append("Perso étendues : " + ", ".join([f"{e}={pers.get(e,0)}" for e in ("Feu","Terre","Air","Eau")]))

    return "\n".join(lines)

