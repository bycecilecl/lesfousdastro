def _score_tagline(total, label: str, level_code: str | None = None) -> str:
    """
    Phrase générique selon le niveau.
    Tu peux affiner avec level_code si tu l'as (ex: L1/L2/L3/L4).
    """
    lab = (label or "").lower()

    # Mapping simple basé sur tes labels actuels
    if "expédition" in lab or "polaire" in lab:
        return "Ici, on n’est pas sur une balade : le karmique est structurant et revient en boucle tant que ce n’est pas intégré."
    if "valise" in lab and "soute" in lab:
        return "Gros bagage karmique : il y a du vécu, des réflexes anciens, et ça peut se rejouer vite si tu pilotes en automatique."
    if "bagage" in lab:
        return "Le thème montre un bagage karmique actif : pas forcément ‘lourd’, mais clairement influent dans les choix et les relations."
    if "léger" in lab or "sac" in lab:
        return "Karmique plutôt léger : l’axe d’évolution est là, mais sans surcharge. Ça se travaille avec plus de souplesse."

    # Fallback basé sur le score (si tu veux)
    try:
        t = float(total) if total is not None else None
    except Exception:
        t = None

    if t is not None and t >= 40:
        return "Poids karmique élevé : les thématiques sont insistantes et demandent une vraie conscience pour éviter la répétition."
    if t is not None and t >= 25:
        return "Poids karmique modéré : plusieurs thèmes reviennent, mais ils se transforment bien dès que tu les nommes clairement."
    return "Poids karmique plutôt léger : la lecture sert surtout à affiner la direction et éviter les automatismes."


def _render_intro_karmique(block, theme, score) -> str:
    data = block.get("data", {}) or {}

    total = data.get("score_total")
    label = data.get("score_label", "—")

    elements = data.get("dominant_elements") or []

    points_29 = data.get("points_29", []) or []   # Asc/Soleil only
    cuspides = data.get("cuspides", []) or []     # Asc/Soleil only

    nn_sign = data.get("nn_sign")
    ns_sign = data.get("ns_sign")
    nn_house = data.get("nn_house")
    ns_house = data.get("ns_house")

    lines = []

    # 1) Texte générique (court, stable, clair)
    lines.append(
        "Cette analyse karmique met en lumière les mémoires et automatismes qui influencent tes réactions "
        "et certaines répétitions de vie.\n"
        "Elle ne prédit pas : elle éclaire. Le but, c’est de reprendre la main sur ce qui se rejoue "
        "en pilote automatique."
    )
    lines.append("")

    # 2) Score + intitulé du voyage
    lines.append(f"Score karmique : {total if total is not None else '—'} — {label}")
    lines.append("")

    # 3) Dominantes élémentaires (+ future BDD)
    if elements:
        dom_txt = " / ".join(elements)
        lines.append(f"Dominante(s) élémentaire(s) : {dom_txt}")

        # (optionnel) BDD intro : ASTRE=INTRO, DONNEE=dominant_elements, VALEUR=Eau
        # on prend la 1ère dominante si plusieurs, simple et robuste
        bdd_dom = _bdd("INTRO", "dominant_elements", elements[0])
        if bdd_dom:
            lines.append(bdd_dom)
        lines.append("")

    # 4) Points sensibles 29° (Asc/Soleil uniquement)
    if points_29:
        shown = []
        for p in points_29:
            nm = p.get("name")
            deg = p.get("deg")
            sg = p.get("signe")
            shown.append(f"{nm} {deg}° {sg}".strip())
        lines.append("Point(s) sensible(s) à 29° : " + " | ".join(shown))
        lines.append("")

    # 5) Entre-deux signes (Asc/Soleil)
    if cuspides:
        lines.append("Entre-deux signes (Ascendant / Soleil) :")
        for c in cuspides:
            name = c.get("name")
            pos = c.get("position")
            cur = c.get("current_sign")
            other = c.get("other_sign")
            deg = c.get("deg")
            if not (name and pos and cur and other):
                continue

            if pos == "fin":
                lines.append(f"- {name} ({deg}°) en fin de {cur} : passage vers {other}.")
            else:
                lines.append(f"- {name} ({deg}°) en début de {cur} : sortie de {other} vers {cur}.")
        lines.append("")

    # 6) Axe des Nœuds (1 ligne large)
    if nn_sign and ns_sign:
        left = f"{ns_sign}" + (f" (Maison {ns_house})" if ns_house is not None else "")
        right = f"{nn_sign}" + (f" (Maison {nn_house})" if nn_house is not None else "")
        lines.append(f"Axe des Nœuds Lunaires : passage de {left} vers {right}.")

    return "\n".join(lines).strip()


