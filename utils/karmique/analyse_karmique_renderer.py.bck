def _render_moon_karmique(block: Dict[str, Any],
                          theme: Dict[str, Any],
                          score: Dict[str, Any]) -> str:
    data = block.get("data", {}) or {}

    moon_sign = data.get("moon_sign")
    moon_house = data.get("moon_house")
    moon_intercepted = data.get("moon_intercepted")
    moon_score = data.get("moon_score", 0)
    hits = data.get("moon_hard_hits", []) or []

    lines = []
    lines.append(
        f"Lune : {moon_sign or '—'}"
        + (f" (Maison {moon_house})" if moon_house is not None else "")
    )

    # Interprétation BDD : signe + maison
    if moon_sign:
        txt = _bdd("Lune", "signe", moon_sign)
        if txt:
            lines.append(txt)

    if moon_house is not None:
        txt = _bdd("Lune", "maison", moon_house)
        if txt:
            lines.append(txt)

    if moon_score:
        lines.append(f"Score Lune karmique : {moon_score}")

    if moon_intercepted:
        lines.append("⚠️ Lune interceptée : émotionnel plus ‘en sous-marin’ / moins direct.")

    lines.append("")
    if hits:
        lines.append("Aspects karmiques Lune (selon orbes karmiques) :")
        for h in hits:
            typ = h.get("type")
            other = h.get("with")
            orb = h.get("orb")

            lines.append(f"- {typ} avec {other} (orbe {orb}°)")

            # Interprétation BDD d’aspect (optionnelle)
            # Clé CSV conseillée :
            # ASTRE=Lune, DONNEE=aspect, VALEUR=Carre_NoeudNord
            # ASTRE=Lune, DONNEE=aspect, VALEUR=Opposition_Chiron
            if typ and other:
                key = f"{typ}_{other}".replace("œ", "oe")
                txt = _bdd("Lune", "aspect", key)
                if txt:
                    lines.append(f"  {txt}")
    else:
        lines.append("Aucun aspect karmique Lune détecté selon tes filtres.")

    return "\n".join(lines)


def _render_synthese_karmique(block: Dict[str, Any],
                              theme: Dict[str, Any],
                              score: Dict[str, Any]) -> str:
    data = block.get("data", {}) or {}

    dom = data.get("dominant_elements") or []
    nn_sign, nn_house = data.get("nn_sign"), data.get("nn_house")
    ns_sign, ns_house = data.get("ns_sign"), data.get("ns_house")
    moon_sign, moon_house = data.get("moon_sign"), data.get("moon_house")

    total = data.get("total_score", "—")
    label = data.get("level_label", "—")
    breakdown = data.get("breakdown", {}) or {}

    # 1) 2–3 moteurs dominants (lisibles)
    drivers = []
    # Tu adaptes les clés selon TON breakdown réel
    # (je reprends celles vues dans tes outputs)
    for k in ("houses_karmic", "nodes", "moon_karmic", "saturn_pluto", "anaretic_29", "amas_signes", "retrogrades"):
        v = breakdown.get(k, 0)
        if v:
            drivers.append((k, v))
    drivers.sort(key=lambda x: x[1], reverse=True)
    drivers = drivers[:3]

    # petites traductions pour que ça lise “humain”
    label_map = {
        "houses_karmic": "Maisons karmiques (IV/VIII/XII)",
        "nodes": "Nœuds Lunaires",
        "moon_karmic": "Mémoire lunaire",
        "saturn_pluto": "Pression Saturne/Pluton",
        "anaretic_29": "Degrés 29° (fin de cycle)",
        "amas_signes": "Amas / surcharge",
        "retrogrades": "Rétrogrades",
    }

    lines = []
    lines.append(f"Signature karmique : {total} — {label}")
    lines.append("")

    # A) direction (axe nodal) — 2 lignes max
    if ns_sign and nn_sign:
        lines.append(f"Axe évolutif : {ns_sign} (Maison {ns_house}) → {nn_sign} (Maison {nn_house}).")
        lines.append("Tu ne “supprimes” pas le passé : tu apprends à ne plus le piloter en automatique.")
        lines.append("")

    # B) climat d’incarnation (éléments) — 1 idée
    if dom:
        lines.append(f"Climat dominant : {' / '.join(dom)}.")
        txt = _bdd("Karmique", "element", dom[0])  # optionnel
        if txt:
            lines.append(txt)
        lines.append("")

    # C) point d’accroche émotionnel (Lune) — sans refaire toute la Lune
    if moon_sign:
        lines.append(f"Point d’accroche émotionnel : Lune en {moon_sign}" + (f" (Maison {moon_house})" if moon_house is not None else "") + ".")
        lines.append("C’est la zone qui réagit vite, fort, et qui demande du soin plutôt que du contrôle.")
        lines.append("")

    # D) ce qui pèse le plus (drivers)
    if drivers:
        lines.append("Ce qui “pèse” le plus dans ton scénario :")
        for k, v in drivers:
            lines.append(f"- {label_map.get(k, k)} : +{v}")
        lines.append("")

    # E) clôture : 3 axes d’action (génériques, utilisables)
    lines.append("Clé d’incarnation (version utile) :")
    lines.append("1) Repérer le réflexe ancien (Nœud Sud) au moment où il se déclenche.")
    lines.append("2) Choisir un micro-mouvement vers le Nœud Nord (même petit, mais conscient).")
    lines.append("3) Revenir au corps et au réel quand l’émotion part en pilotage automatique (Lune).")

    return "\n".join(lines)

def _render_maison_12(block: Dict[str, Any], theme: Dict[str, Any], score: Dict[str, Any]) -> str:
    # Si content existe déjà, on le garde
    if isinstance(block.get("content"), str) and block["content"].strip():
        return block["content"]
    
    # Sinon, on cherche text à la RACINE (pas dans data)
    return block.get("text", "")