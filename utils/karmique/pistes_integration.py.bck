CATEGORIES_VALIDES = list(LEVIERS_PAR_TENSION.keys())


def _ajouter_si_absent(dest: List[str], valeur: str) -> None:
    if valeur not in dest:
        dest.append(valeur)


def detecter_types_tensions(global_tension_points: List[str]) -> List[str]:
    """
    Fallback : convertit des tensions textuelles libres en catégories normalisées.
    Utilisé uniquement si global_tension_types n'est pas disponible en amont.
    """
    resultats: List[str] = []

    for tension in global_tension_points or []:
        t = str(tension or "").lower().strip()
        if not t:
            continue

        if any(mot in t for mot in [
            "surcontrôle", "surcontrole", "contrôle", "controle",
            "maîtrise", "maitrise", "contention", "retenir",
            "rigidité", "rigidite", "verrouillage"
        ]):
            _ajouter_si_absent(resultats, "surcontrole")

        if any(mot in t for mot in [
            "suradaptation", "adaptation excessive", "plaire",
            "validation", "regard extérieur", "regard exterieur",
            "conformité", "conformite", "surajustement"
        ]):
            _ajouter_si_absent(resultats, "suradaptation")

        if any(mot in t for mot in [
            "évitement émotionnel", "evitement emotionnel",
            "couper de l'émotion", "émotion", "emotion",
            "mentalisation", "intellectualisation"
        ]):
            _ajouter_si_absent(resultats, "evitement_emotionnel")

        if any(mot in t for mot in [
            "limite", "dire non", "envahissement",
            "sur-responsabilité", "perméabilité", "permeabilite"
        ]):
            _ajouter_si_absent(resultats, "difficulte_limites")

        if any(mot in t for mot in [
            "hypervigilance", "scanner", "surveillance",
            "alerte", "danger", "insécurité", "insecurite"
        ]):
            _ajouter_si_absent(resultats, "hypervigilance")

        if any(mot in t for mot in [
            "fusion", "engloutissement", "perdre le fil de soi",
            "dépendance", "dependance", "confusion relationnelle",
            "se dissoudre", "se fondre"
        ]):
            _ajouter_si_absent(resultats, "fusion")

        if any(mot in t for mot in [
            "trahison", "déception", "deception",
            "test relationnel", "contrat implicite"
        ]):
            _ajouter_si_absent(resultats, "blessure_trahison")

        if any(mot in t for mot in [
            "abandon", "peur de perdre", "effacement",
            "surinvestissement relationnel"
        ]):
            _ajouter_si_absent(resultats, "peur_abandon")

        if any(mot in t for mot in [
            "pouvoir", "domination", "soumission",
            "colère retournée", "colere retournee", "impuissance", "emprise"
        ]):
            _ajouter_si_absent(resultats, "rapport_pouvoir")

        if any(mot in t for mot in [
            "illégitimité", "illegitimite", "imposteur",
            "pas à la hauteur", "minimisation de soi"
        ]):
            _ajouter_si_absent(resultats, "illegitimite")

        if any(mot in t for mot in [
            "sacrifice", "s'oublier", "s oublier",
            "se mettre après", "utilité", "s'effacer"
        ]):
            _ajouter_si_absent(resultats, "sacrifice_soi")

        if any(mot in t for mot in [
            "isolement", "retrait défensif", "retrait defensif",
            "tout gérer seul", "autosuffisance", "solitude protectrice"
        ]):
            _ajouter_si_absent(resultats, "isolement_choisi")

        if any(mot in t for mot in [
            "perfectionnisme", "perfection", "juge intérieur", "juge interieur",
            "autocritique", "jamais assez bien"
        ]):
            _ajouter_si_absent(resultats, "perfectionnisme")

    return resultats


def generer_pistes_brutes(
    global_tension_points: List[str],
    ressources: List[str],
    max_pistes: int = 3,
    global_tension_types: List[str] | None = None,
) -> List[Dict[str, Any]]:
    """
    Sélectionne des leviers concrets à partir des tensions détectées.

    Priorité :
      1. global_tension_types  → clés normalisées produites en amont (idéal)
      2. global_tension_points → texte libre, fallback via detecter_types_tensions()
    """
    pistes: List[Dict[str, Any]] = []

    # Niveau 1 : clés normalisées disponibles en amont
    if global_tension_types:
        types_tensions = [t for t in global_tension_types if t in LEVIERS_PAR_TENSION]
        non_reconnus = [t for t in global_tension_types if t not in LEVIERS_PAR_TENSION]
        if non_reconnus:
            print(f"⚠️ Clés non reconnues dans global_tension_types : {non_reconnus}")

    # Niveau 2 : fallback sur détection textuelle
    else:
        types_tensions = detecter_types_tensions(global_tension_points)
        non_mappes = [
            t for t in (global_tension_points or [])
            if not detecter_types_tensions([t])
        ]
        if non_mappes:
            print(f"⚠️ Tensions non mappées : {non_mappes}")

    if not types_tensions:
        return pistes

    for index, tension_type in enumerate(types_tensions):
        candidats = LEVIERS_PAR_TENSION.get(tension_type, [])
        if not candidats:
            continue

        levier = candidats[index % len(candidats)]
        ressource_associee = ressources[index % len(ressources)] if ressources else ""

        pistes.append({
            "tension_type": tension_type,
            "ressource_associee": ressource_associee,
            "a_observer": levier["a_observer"],
            "a_tester": levier["a_tester"],
            "enjeu": levier["enjeu"],
        })

        if len(pistes) >= max_pistes:
            break

    return pistes